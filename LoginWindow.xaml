<Window x:Class="Autokolcsonzo.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bejelentkezés" Height="260" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FF00BFFF">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Név:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,15"/>
        <TextBox x:Name="tbNev" Grid.Row="0" Grid.Column="1" Height="28" FontSize="14" Margin="0,0,0,15"/>

        <TextBlock Text="Jelszó:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="14" Margin="0,0,0,20"/>
        <PasswordBox x:Name="pbJelszo" Grid.Row="1" Grid.Column="1" Height="28" FontSize="14" Margin="0,0,0,20"/>

        <Button Content="Belépés" Grid.Row="2" Grid.Column="1" Width="110" Height="32"
                HorizontalAlignment="Left" Click="btnBelepes_Click" FontSize="14"/>
    </Grid>
</Window>